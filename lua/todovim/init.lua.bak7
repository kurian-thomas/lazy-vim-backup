local M = {}

-- State
local state = {
  wins = {},
  bufs = {},
  header_win = nil,
  header_buf = nil,
  backdrop_win = nil,
}

local default_opts = {
  files = {
    "~/notes/todo.md",
    "~/notes/pending.md",
    "~/notes/done.md",
  },
  archive_file = "~/notes/archive.md",
  titles = { " TODO ", " PENDING ", " DONE " },
  border = "single",
  width = 0.8,
  height = 0.8,
}

local function expand_path(path)
  if path:sub(1, 1) == "~" then return os.getenv("HOME") .. path:sub(2) end
  return path
end

local function ensure_dir(path)
  local dir = vim.fn.fnamemodify(path, ":h")
  if vim.fn.isdirectory(dir) == 0 then vim.fn.mkdir(dir, "p") end
end

local function save_buffer(buf)
  if buf and vim.api.nvim_buf_is_valid(buf) then
    vim.api.nvim_buf_call(buf, function() vim.cmd("silent! write") end)
  end
end

local function get_progress_stats()
  local total = 0
  local done = 0

  for _, buf in ipairs(state.bufs) do
    if vim.api.nvim_buf_is_valid(buf) then
      local lines = vim.api.nvim_buf_get_lines(buf, 0, -1, false)
      for _, line in ipairs(lines) do
        if not line:match("^%s*#") then
          local is_incomplete = line:match("%- %[ %]")
          local is_complete = line:match("%- %[x%]")

          if is_incomplete then
            total = total + 1
          elseif is_complete then
            total = total + 1
            done = done + 1
          end
        end
      end
    end
  end

  if total == 0 then return 0 end
  return math.floor((done / total) * 100)
end

-- FIXED #3: Use strdisplaywidth for correct padding with unicode icons
local function render_header()
  if not state.header_buf or not vim.api.nvim_buf_is_valid(state.header_buf) then return end

  local percent = get_progress_stats()
  local bar_width = 15
  local filled = math.floor((percent / 100) * bar_width)
  local bar = string.rep("█", filled) .. string.rep("░", bar_width - filled)

  -- Left Side
  local keys =
  "Nav Between Panels: ←/→ | Move Items: C-S-←/→ | C-↑|↓ | Toggle Check: <Ent> | Add: o | Del: C-d | Archive: <Ldr>a | Quit: q"
  -- Right Side
  local right_text = string.format("%s %3d%% ", bar, percent)

  -- Calculate Spacing using display width, not byte length
  local win_width = vim.api.nvim_win_get_width(state.header_win)
  local keys_width = vim.fn.strdisplaywidth(keys)
  local right_width = vim.fn.strdisplaywidth(right_text)

  local padding_len = win_width - keys_width - right_width
  if padding_len < 0 then padding_len = 1 end

  local line = keys .. string.rep(" ", padding_len) .. right_text

  vim.api.nvim_buf_set_lines(state.header_buf, 0, -1, false, { line })
end

local function open_backdrop()
  local buf = vim.api.nvim_create_buf(false, true)
  local win = vim.api.nvim_open_win(buf, false, {
    relative = "editor",
    width = vim.o.columns,
    height = vim.o.lines,
    col = 0,
    row = 0,
    style = "minimal",
    zindex = 1
  })
  vim.api.nvim_set_hl(0, "KanbanBackdrop", { bg = "#000000", default = true })
  vim.api.nvim_set_option_value("winhighlight", "Normal:KanbanBackdrop", { win = win })
  vim.api.nvim_set_option_value("winblend", 40, { win = win })
  state.backdrop_win = win
end

-- FIXED #2: Subtract 2 from width to account for header borders
local function open_header_window(opts)
  local screen_w = vim.o.columns

  local total_width_raw = math.floor(screen_w * opts.width)
  local win_width = math.floor(total_width_raw / 3)
  local exact_total_width = win_width * 3

  local start_col = math.floor((screen_w - exact_total_width) / 2)
  local row = math.floor((vim.o.lines - math.floor(vim.o.lines * opts.height)) / 2)

  local buf = vim.api.nvim_create_buf(false, true)
  -- Subtract 2 for the left/right border of the header itself
  local win = vim.api.nvim_open_win(buf, false, {
    relative = "editor",
    width = exact_total_width - 2,
    height = 1,
    col = start_col,
    row = row - 3,
    style = "minimal",
    border = opts.border,
    zindex = 50
  })

  vim.api.nvim_set_option_value("winhighlight", "Normal:Normal,FloatBorder:Comment", { win = win })
  state.header_win = win
  state.header_buf = buf
end

local function set_syntax(buf)
  vim.api.nvim_buf_call(buf, function()
    vim.bo.filetype = "markdown"
    vim.cmd([[syntax match TodoUrgent /@urgent/ containedin=ALL]])
    vim.cmd([[syntax match TodoHigh /@high/ containedin=ALL]])
    vim.cmd([[syntax match TodoProject /#[a-zA-Z0-9_-]\+/ containedin=ALL]])
    vim.cmd([[highlight default link TodoUrgent ErrorMsg]])
    vim.cmd([[highlight default link TodoHigh WarningMsg]])
    vim.cmd([[highlight default link TodoProject Identifier]])
  end)
end

local function update_highlights()
  local current_win = vim.api.nvim_get_current_win()
  for _, win in ipairs(state.wins) do
    if vim.api.nvim_win_is_valid(win) then
      if win == current_win then
        vim.api.nvim_set_option_value("winhighlight", "FloatBorder:FloatBorder", { win = win })
      else
        vim.api.nvim_set_option_value("winhighlight", "FloatBorder:Comment", { win = win })
      end
    end
  end
end

local function get_win_config(index, opts)
  local screen_w = vim.o.columns
  local total_width_raw = math.floor(screen_w * opts.width)
  local win_width = math.floor(total_width_raw / 3)
  local exact_total_width = win_width * 3

  local total_height = math.floor(vim.o.lines * opts.height)
  local start_col = math.floor((screen_w - exact_total_width) / 2)
  local row = math.floor((vim.o.lines - total_height) / 2)
  local col = start_col + ((index - 1) * win_width)

  return {
    relative = "editor",
    width = win_width - 2,
    height = total_height,
    col = col,
    row = row,
    border = opts.border,
    style = "minimal",
    title = opts.titles[index] or "",
    title_pos = "center",
    zindex = 50
  }
end

local function navigate(direction)
  local cur = vim.api.nvim_get_current_win()
  local idx = 1
  for i, w in ipairs(state.wins) do if w == cur then idx = i end end

  local next_idx = (direction == "next") and (idx % 3) + 1 or ((idx - 2) % 3) + 1
  if state.wins[next_idx] and vim.api.nvim_win_is_valid(state.wins[next_idx]) then
    vim.api.nvim_set_current_win(state.wins[next_idx])
    update_highlights()
  end
end

local function archive_done_tasks(opts)
  local done_buf = state.bufs[3]
  local lines = vim.api.nvim_buf_get_lines(done_buf, 0, -1, false)
  local content = {}
  for _, line in ipairs(lines) do if line ~= "" then table.insert(content, line) end end

  if #content == 0 then return end

  local path = expand_path(opts.archive_file or default_opts.archive_file)
  ensure_dir(path)
  local file = io.open(path, "a")
  if file then
    file:write("\n# Archived " .. os.date("%Y-%m-%d") .. "\n")
    for _, l in ipairs(content) do file:write(l .. "\n") end
    file:close()
  end

  vim.api.nvim_buf_set_lines(done_buf, 0, -1, false, {})
  save_buffer(done_buf)
  render_header()
  vim.notify("Archived " .. #content, vim.log.levels.INFO)
end

local function toggle_todo()
  local win = vim.api.nvim_get_current_win()
  local buf = vim.api.nvim_win_get_buf(win)
  local line = vim.api.nvim_get_current_line()
  local new = line:match("%- %[ %]") and line:gsub("%- %[ %]", "- [x]")
      or line:match("%- %[x%]") and line:gsub("%- %[x%]", "- [ ]")
      or "- [ ] " .. line
  vim.api.nvim_set_current_line(new)
  save_buffer(buf)
  render_header()
end

local function add_new_task(opts)
  local win = vim.api.nvim_get_current_win()
  local buf = vim.api.nvim_win_get_buf(win)
  local r = vim.api.nvim_win_get_cursor(win)[1]
  vim.api.nvim_buf_set_lines(buf, r, r, false, { "- [ ] " })
  vim.api.nvim_win_set_cursor(win, { r + 1, 6 })
  vim.cmd("startinsert")
  render_header()
end

local function delete_line(opts)
  local win = vim.api.nvim_get_current_win()
  local buf = vim.api.nvim_win_get_buf(win)
  vim.api.nvim_del_current_line()
  save_buffer(buf)
  render_header()
end

local function move_line_circular(direction, opts)
  local cur = vim.api.nvim_get_current_win()
  local idx = 1
  for i, w in ipairs(state.wins) do if w == cur then idx = i end end

  local line = vim.api.nvim_get_current_line()
  if line == "" then return end

  local target_idx = (direction == "next") and (idx % 3) + 1 or ((idx - 2) % 3) + 1
  if target_idx == 3 then
    line = line:gsub("%- %[ %]", "- [x]")
  elseif idx == 3 then
    line = line:gsub("%- %[x%]", "- [ ]")
  end

  vim.api.nvim_del_current_line()
  save_buffer(state.bufs[idx])

  local t_buf = state.bufs[target_idx]
  vim.api.nvim_buf_set_lines(t_buf, -1, -1, false, { line })
  save_buffer(t_buf)
  render_header()
end

-- FIXED #1: Explicit logic to swap lines without relying on confusing unpack ranges
local function move_line_vertical(direction)
  local win = vim.api.nvim_get_current_win()
  local buf = vim.api.nvim_win_get_buf(win)
  local row = vim.api.nvim_win_get_cursor(win)[1] -- 1-based current row
  local max = vim.api.nvim_buf_line_count(buf)

  if direction == "up" and row > 1 then
    -- Get current line and the line above it
    local current_line = vim.api.nvim_buf_get_lines(buf, row - 1, row, false)[1]
    local line_above = vim.api.nvim_buf_get_lines(buf, row - 2, row - 1, false)[1]

    -- Swap them
    vim.api.nvim_buf_set_lines(buf, row - 2, row, false, { current_line, line_above })
    vim.api.nvim_win_set_cursor(win, { row - 1, 0 })
  elseif direction == "down" and row < max then
    -- Get current line and the line below it
    local current_line = vim.api.nvim_buf_get_lines(buf, row - 1, row, false)[1]
    local line_below = vim.api.nvim_buf_get_lines(buf, row, row + 1, false)[1]

    -- Swap them
    vim.api.nvim_buf_set_lines(buf, row - 1, row + 1, false, { line_below, current_line })
    vim.api.nvim_win_set_cursor(win, { row + 1, 0 })
  end
  save_buffer(buf)
end

local function close_all_windows()
  for _, buf in ipairs(state.bufs) do save_buffer(buf) end
  for _, win in ipairs(state.wins) do if vim.api.nvim_win_is_valid(win) then vim.api.nvim_win_close(win, true) end end
  if state.header_win and vim.api.nvim_win_is_valid(state.header_win) then vim.api.nvim_win_close(state.header_win, true) end
  if state.backdrop_win and vim.api.nvim_win_is_valid(state.backdrop_win) then
    vim.api.nvim_win_close(state.backdrop_win,
      true)
  end
  state = { wins = {}, bufs = {}, header_win = nil, backdrop_win = nil }
end

local function toggle_floating_files(opts)
  if #state.wins > 0 and vim.api.nvim_win_is_valid(state.wins[1]) then
    close_all_windows(); return
  end

  local files = opts.files
  if opts.target_file and opts.files == default_opts.files then
    files = { opts.target_file, "~/notes/pending.md", "~/notes/done.md" }
  end

  open_backdrop()
  open_header_window(opts)

  for i = 1, 3 do
    local path = expand_path(files[i] or "~/notes/scratch_" .. i .. ".md")
    ensure_dir(path)
    local buf = vim.fn.bufnr(path, true)
    if buf == -1 then
      buf = vim.api.nvim_create_buf(false, false); vim.api.nvim_buf_set_name(buf, path)
    end
    if not vim.api.nvim_buf_is_loaded(buf) then vim.fn.bufload(buf) end
    vim.bo[buf].swapfile = false
    set_syntax(buf)

    local win = vim.api.nvim_open_win(buf, true, get_win_config(i, opts))
    table.insert(state.wins, win)
    table.insert(state.bufs, buf)

    local map_opts = { noremap = true, silent = true, buffer = buf }
    vim.keymap.set('n', '<C-S-Right>', function() navigate("next") end, map_opts)
    vim.keymap.set('n', '<C-S-Left>', function() navigate("prev") end, map_opts)
    vim.keymap.set('n', '<C-Right>', function() move_line_circular("next", opts) end, map_opts)
    vim.keymap.set('n', '<C-Left>', function() move_line_circular("prev", opts) end, map_opts)
    vim.keymap.set('n', '<C-Up>', function() move_line_vertical("up") end, map_opts)
    vim.keymap.set('n', '<C-Down>', function() move_line_vertical("down") end, map_opts)
    vim.keymap.set('n', '<Enter>', function() toggle_todo() end, map_opts)
    vim.keymap.set('n', 'o', function() add_new_task(opts) end, map_opts)
    vim.keymap.set('n', '<C-d>', function() delete_line(opts) end, map_opts)
    vim.keymap.set('n', '<leader>a', function() archive_done_tasks(opts) end, map_opts)
    vim.keymap.set('n', 'q', function() close_all_windows() end, map_opts)
  end

  vim.api.nvim_set_current_win(state.wins[2])
  update_highlights()
  render_header()
end

M.setup = function(opts)
  opts = vim.tbl_deep_extend("force", default_opts, opts or {})
  vim.api.nvim_create_user_command("Td", function() toggle_floating_files(opts) end, {})
end

return M
