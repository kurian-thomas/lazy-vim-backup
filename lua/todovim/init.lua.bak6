local M = {}

-- State
local state = {
  wins = {},
  bufs = {},
  header_win = nil,
  header_buf = nil
}

local default_opts = {
  files = {
    "~/notes/todo.md",
    "~/notes/pending.md",
    "~/notes/done.md",
  },
  archive_file = "~/notes/archive.md",
  titles = { " TODO ", " PENDING ", " DONE " },
  border = "single",
  width = 0.8,
  height = 0.8,
}

local function expand_path(path)
  if path:sub(1, 1) == "~" then return os.getenv("HOME") .. path:sub(2) end
  return path
end

local function ensure_dir(path)
  local dir = vim.fn.fnamemodify(path, ":h")
  if vim.fn.isdirectory(dir) == 0 then vim.fn.mkdir(dir, "p") end
end

local function save_buffer(buf)
  if buf and vim.api.nvim_buf_is_valid(buf) then
    vim.api.nvim_buf_call(buf, function() vim.cmd("silent! write") end)
  end
end

-- Feature: Header Window for Keybindings
local function open_header_window(opts)
  local screen_w = vim.o.columns
  local total_width = math.floor(screen_w * opts.width)
  local start_col = math.floor((screen_w - total_width) / 2)
  local screen_h = vim.o.lines
  local total_height = math.floor(screen_h * opts.height)
  local row = math.floor((screen_h - total_height) / 2)

  local buf = vim.api.nvim_create_buf(false, true)
  local keys_text =
  " Navigate: ←/→ | Move: C-←/→ | Reorder: C-↑/↓ | Toggle: <Ent> | Add: o | Del: C-d | Archive: <Ldr>a"

  -- Center text manually
  local padding = string.rep(" ", math.floor((total_width - #keys_text) / 2))
  vim.api.nvim_buf_set_lines(buf, 0, -1, false, { padding .. keys_text })

  local win_config = {
    relative = "editor",
    width = total_width,
    height = 1,
    col = start_col,
    row = row - 3, -- Position above the main columns
    style = "minimal",
    border = opts.border,
  }

  local win = vim.api.nvim_open_win(buf, false, win_config)
  vim.api.nvim_set_option_value("winhighlight", "Normal:Normal,FloatBorder:Comment", { win = win })

  state.header_win = win
  state.header_buf = buf
end

local function set_syntax(buf)
  vim.api.nvim_buf_call(buf, function()
    vim.bo.filetype = "markdown"
    vim.cmd([[syntax match TodoUrgent /@urgent/ containedin=ALL]])
    vim.cmd([[syntax match TodoHigh /@high/ containedin=ALL]])
    vim.cmd([[syntax match TodoProject /#[a-zA-Z0-9_-]\+/ containedin=ALL]])
    vim.cmd([[highlight default link TodoUrgent ErrorMsg]])
    vim.cmd([[highlight default link TodoHigh WarningMsg]])
    vim.cmd([[highlight default link TodoProject Identifier]])
  end)
end

local function update_highlights()
  local current_win = vim.api.nvim_get_current_win()
  for _, win in ipairs(state.wins) do
    if vim.api.nvim_win_is_valid(win) then
      if win == current_win then
        vim.api.nvim_set_option_value("winhighlight", "FloatBorder:FloatBorder", { win = win })
      else
        vim.api.nvim_set_option_value("winhighlight", "FloatBorder:Comment", { win = win })
      end
    end
  end
end

local function get_win_config(index, opts)
  local screen_w = vim.o.columns
  local screen_h = vim.o.lines
  local total_width = math.floor(screen_w * opts.width)
  local total_height = math.floor(screen_h * opts.height)
  local win_width = math.floor(total_width / 3)

  local start_col = math.floor((screen_w - total_width) / 2)
  local row = math.floor((screen_h - total_height) / 2)
  local col = start_col + ((index - 1) * win_width)

  return {
    relative = "editor",
    width = win_width - 2,
    height = total_height,
    col = col,
    row = row,
    border = opts.border,
    style = "minimal",
    title = opts.titles[index] or "", -- Static title only
    title_pos = "center",
  }
end

local function get_current_win_index()
  local current_win = vim.api.nvim_get_current_win()
  for i, win in ipairs(state.wins) do
    if win == current_win then return i end
  end
  return nil
end

local function navigate(direction)
  local idx = get_current_win_index()
  if not idx then return end

  local next_idx = (direction == "next") and (idx % 3) + 1 or ((idx - 2) % 3) + 1
  local target_win = state.wins[next_idx]

  if target_win and vim.api.nvim_win_is_valid(target_win) then
    vim.api.nvim_set_current_win(target_win)
    update_highlights()
  end
end

local function archive_done_tasks(opts)
  local done_buf = state.bufs[3]
  if not done_buf or not vim.api.nvim_buf_is_valid(done_buf) then return end

  local lines = vim.api.nvim_buf_get_lines(done_buf, 0, -1, false)
  local content = {}
  for _, line in ipairs(lines) do
    if line ~= "" then table.insert(content, line) end
  end

  if #content == 0 then
    vim.notify("No tasks to archive", vim.log.levels.INFO)
    return
  end

  local archive_path = expand_path(opts.archive_file or default_opts.archive_file)
  ensure_dir(archive_path)
  local file = io.open(archive_path, "a")
  if file then
    file:write("\n# Archived on " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n")
    for _, line in ipairs(content) do file:write(line .. "\n") end
    file:close()
  end

  vim.api.nvim_buf_set_lines(done_buf, 0, -1, false, {})
  save_buffer(done_buf)
  vim.notify("Archived " .. #content .. " tasks", vim.log.levels.INFO)
end

local function toggle_todo()
  local win = vim.api.nvim_get_current_win()
  local buf = vim.api.nvim_win_get_buf(win)
  local line = vim.api.nvim_get_current_line()
  local new_line = line:match("%- %[ %]") and line:gsub("%- %[ %]", "- [x]")
      or line:match("%- %[x%]") and line:gsub("%- %[x%]", "- [ ]")
      or "- [ ] " .. line

  vim.api.nvim_set_current_line(new_line)
  save_buffer(buf)
end

local function add_new_task(opts)
  local win = vim.api.nvim_get_current_win()
  local buf = vim.api.nvim_win_get_buf(win)
  local cursor = vim.api.nvim_win_get_cursor(win)
  local row = cursor[1]
  vim.api.nvim_buf_set_lines(buf, row, row, false, { "- [ ] " })
  vim.api.nvim_win_set_cursor(win, { row + 1, 6 })
  vim.cmd("startinsert")
end

local function delete_line(opts)
  local win = vim.api.nvim_get_current_win()
  local buf = vim.api.nvim_win_get_buf(win)
  vim.api.nvim_del_current_line()
  save_buffer(buf)
end

local function move_line_circular(direction, opts)
  local idx = get_current_win_index()
  if not idx then return end

  local current_buf = state.bufs[idx]
  local line_text = vim.api.nvim_get_current_line()
  if line_text == "" then return end

  vim.api.nvim_del_current_line()
  save_buffer(current_buf)

  local target_idx = (direction == "next") and (idx % 3) + 1 or ((idx - 2) % 3) + 1
  local target_buf = state.bufs[target_idx]

  if target_buf and vim.api.nvim_buf_is_valid(target_buf) then
    vim.api.nvim_buf_set_lines(target_buf, -1, -1, false, { line_text })
    save_buffer(target_buf)
  end
end

local function move_line_vertical(direction)
  local win = vim.api.nvim_get_current_win()
  local buf = vim.api.nvim_win_get_buf(win)
  local cursor = vim.api.nvim_win_get_cursor(win)
  local row = cursor[1]
  local total_lines = vim.api.nvim_buf_line_count(buf)

  if direction == "up" and row > 1 then
    local line_curr = vim.api.nvim_buf_get_lines(buf, row - 1, row, false)[1]
    local line_above = vim.api.nvim_buf_get_lines(buf, row - 2, row - 1, false)[1]
    vim.api.nvim_buf_set_lines(buf, row - 2, row, false, { line_curr, line_above })
    vim.api.nvim_win_set_cursor(win, { row - 1, cursor[2] })
    save_buffer(buf)
  elseif direction == "down" and row < total_lines then
    local line_curr = vim.api.nvim_buf_get_lines(buf, row - 1, row, false)[1]
    local line_below = vim.api.nvim_buf_get_lines(buf, row, row + 1, false)[1]
    vim.api.nvim_buf_set_lines(buf, row - 1, row + 1, false, { line_below, line_curr })
    vim.api.nvim_win_set_cursor(win, { row + 1, cursor[2] })
    save_buffer(buf)
  end
end

local function close_all_windows()
  for _, buf in ipairs(state.bufs) do save_buffer(buf) end
  for _, win in ipairs(state.wins) do
    if vim.api.nvim_win_is_valid(win) then vim.api.nvim_win_close(win, true) end
  end
  if state.header_win and vim.api.nvim_win_is_valid(state.header_win) then
    vim.api.nvim_win_close(state.header_win, true)
  end
  state.wins = {}
  state.bufs = {}
  state.header_win = nil
end

local function toggle_floating_files(opts)
  if #state.wins > 0 and vim.api.nvim_win_is_valid(state.wins[1]) then
    close_all_windows()
    return
  end

  state.wins = {}
  state.bufs = {}

  local files_to_open = opts.files
  if opts.target_file and opts.files == default_opts.files then
    files_to_open = { opts.target_file, "~/notes/pending.md", "~/notes/done.md" }
  end

  -- Open Header
  open_header_window(opts)

  -- Open Main Windows
  for i = 1, 3 do
    local path = files_to_open[i] or "~/notes/scratch_" .. i .. ".md"
    local expanded_path = expand_path(path)
    ensure_dir(expanded_path)

    local buf = vim.fn.bufnr(expanded_path, true)
    if buf == -1 then
      buf = vim.api.nvim_create_buf(false, false)
      vim.api.nvim_buf_set_name(buf, expanded_path)
    end

    if not vim.api.nvim_buf_is_loaded(buf) then vim.fn.bufload(buf) end
    vim.bo[buf].swapfile = false
    set_syntax(buf)

    local win = vim.api.nvim_open_win(buf, true, get_win_config(i, opts))

    table.insert(state.wins, win)
    table.insert(state.bufs, buf)

    local map_opts = { noremap = true, silent = true, buffer = buf }

    -- Navigation
    vim.keymap.set('n', '<Right>', function() navigate("next") end, map_opts)
    vim.keymap.set('n', '<Left>', function() navigate("prev") end, map_opts)

    -- Movement
    vim.keymap.set('n', '<C-Right>', function() move_line_circular("next", opts) end, map_opts)
    vim.keymap.set('n', '<C-Left>', function() move_line_circular("prev", opts) end, map_opts)
    vim.keymap.set('n', '<C-Up>', function() move_line_vertical("up") end, map_opts)
    vim.keymap.set('n', '<C-Down>', function() move_line_vertical("down") end, map_opts)

    -- Actions
    vim.keymap.set('n', '<Enter>', function() toggle_todo() end, map_opts)
    vim.keymap.set('n', 'o', function() add_new_task(opts) end, map_opts)
    vim.keymap.set('n', '<C-d>', function() delete_line(opts) end, map_opts)
    vim.keymap.set('n', '<leader>a', function() archive_done_tasks(opts) end, map_opts)
    -- vim.keymap.set('n', 'q', function() close_all_windows() end, map_opts)
  end

  vim.api.nvim_set_current_win(state.wins[2])
  update_highlights()
end

M.setup = function(opts)
  opts = vim.tbl_deep_extend("force", default_opts, opts or {})
  vim.api.nvim_create_user_command("Td", function() toggle_floating_files(opts) end, {})
end

return M
